# FactGuard AI Backend Configuration
# Copy this file to .env and fill in your optional API keys.
# Leave keys empty to use offline / local models and free RSS fallback.

# Server Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# External API Keys (Optional)
# Google Fact Check Tools API Key: https://developers.google.com/fact-check/tools/api
FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# Google Cloud Vision API Key (Web Detection & OCR): https://cloud.google.com/vision
VISION_API_KEY=your_google_cloud_vision_api_key_here

# SerpApi Key for Google Lens Visual Search: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Hugging Face Access Token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here
HF_TOKEN=your_huggingface_token_here

# Google Gemini API Key (Optional for grounded search): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

